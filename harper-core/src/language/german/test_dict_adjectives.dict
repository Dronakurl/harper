# Test dictionary with adjective degree annotations
# Format: word/~annotations # comment

schön/~J # schön - basic form (positive)
schöner/~Jk # schöner - comparative
schönsten/~Jq # schönsten - superlative (used with am)

schnell/~J # schnell - basic form
schneller/~Jk # schneller - comparative
schnellsten/~Jq # schnellsten - superlative

groß/~J # groß - basic form
größer/~Jk # größer - comparative
gößten/~Jq # größten - superlative

gut/~J # gut - basic form (irregular)
besser/~Jk # besser - comparative (irregular)
besten/~Jq # besten - superlative (irregular)