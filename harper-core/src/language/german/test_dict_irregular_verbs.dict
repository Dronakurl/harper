# Test dictionary with irregular verb conjugations
# Format: word/~annotations # comment

# haben (to have) - irregular
haben/~Va # infinitiv
habe/~Vh # ich habe - 1st person singular
hast/~Vi # du hast - 2nd person singular
hat/~Vk # er/sie/es hat - 3rd person singular
haben/~V # wir/Sie/sie haben - plural
hattet/~V # ihr habt - 2nd person plural
hatte/~Vb # ich/er hatte - preterite
hatten/~Vb # wir hatten - preterite
habend/~Vd # partizip 1 (present participle)
gehabt/~Vg # partizip 2 (past participle)

# sein (to be) - highly irregular
sein/~Va # infinitiv
bin/~Vh # ich bin - 1st person singular
bist/~Vi # du bist - 2nd person singular
ist/~Vk # er/sie/es ist - 3rd person singular
sind/~V # wir/Sie/sie sind - plural
seid/~V # ihr seid - 2nd person plural
war/~Vb # ich/er war - preterite
waren/~Vb # wir waren - preterite
seiend/~Vd # partizip 1
gewesen/~Vg # partizip 2

# werden (to become) - irregular
werden/~Va # infinitiv
werde/~Vh # ich werde - 1st person singular
wirst/~Vi # du wirst - 2nd person singular
wird/~Vk # er/sie/es wird - 3rd person singular
werden/~V # wir/Sie/sie werden - plural
werdet/~V # ihr werdet - 2nd person plural
wurde/~Vb # ich/er wurde - preterite
wurden/~Vb # wir wurden - preterite
werdend/~Vd # partizip 1
geworden/~Vg # partizip 2

# können (can) - modal verb
können/~Va # infinitiv
kann/~Vh # ich kann - 1st person singular
kannst/~Vi # du kannst - 2nd person singular
kann/~Vk # er/sie/es kann - 3rd person singular
können/~V # wir/Sie/sie können - plural
könnt/~V # ihr könnt - 2nd person plural
konnte/~Vb # ich/er konnte - preterite
konnten/~Vb # wir konnten - preterite

# müssen (must) - modal verb
müssen/~Va # infinitiv
muss/~Vh # ich muss - 1st person singular
musst/~Vi # du musst - 2nd person singular
muss/~Vk # er/sie/es muss - 3rd person singular
müssen/~V # wir/Sie/sie müssen - plural
müsst/~V # ihr müsst - 2nd person plural
musste/~Vb # ich/er musste - preterite
mussten/~Vb # wir mussten - preterite